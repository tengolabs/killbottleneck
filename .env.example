# killBottleneck — configuration (copy to .env and edit)
#
# Renaming note: these variables used to be called FLOWMAP_*. The old names still
# work, so there's no need to rewrite a .env from an earlier version — but fresh
# installs should use KB_* directly.

# Port killBottleneck listens on (http://SERVER-IP:PORT)
KB_PORT=8090

# Container name (optional). Change it to run a second instance next to the
# first one on the same host, e.g. KB_NAME=killbottleneck-test
# KB_NAME=killbottleneck

# Instance time zone (optional). Decides which zone "day" and hour are counted in
# for projects created automatically from recurring templates (e.g. "every Monday").
# Empty/UTC = default. Set your own zone so that "Monday" and the creation time
# match local time, e.g. Europe/Prague. Applies TO THE WHOLE INSTANCE (a team
# spread across zones gets the server's zone, not each user's).
TZ=UTC
# Hour (0–23, in the TZ zone) from which recurring templates are created that day.
# If the server slept through that hour (was powered off), they're created at the
# next later hour the same day. Default 5 (morning).
KB_AUTO_HOUR=5

# AI features (optional):
#   none   = killBottleneck runs without AI (maps, sharing and comments work fully)
#   openai = ANY OpenAI-compatible API — OpenAI, OpenRouter, Groq, Mistral,
#            Together, vLLM, LM Studio, llama.cpp, a liteLLM proxy...
#            (KB_AI_URL = base address, usually ending in /v1;
#             KB_AI_TOKEN = your API key; KB_AI_MODEL = the exact model name)
#   ollama = your own local model via Ollama (KB_AI_URL = the Ollama address,
#            e.g. http://192.168.1.10:11434; KB_AI_MODEL = the model name)
#   api    = a remote AI service compatible with the killBottleneck API (you get the URL and token from the provider)
#   custom = your own AI endpoint implementing the same API contract
#            (documented at killbottleneck.com/reference/custom-ai-endpoint)
KB_AI_PROVIDER=none
KB_AI_URL=
KB_AI_TOKEN=
# provider=ollama: the model Ollama should use (ollama pull <model>)
# provider=openai: the exact model name your provider expects, e.g. gpt-4o-mini
#                  or openai/gpt-4o-mini on OpenRouter
KB_AI_MODEL=
# Optional: speech-to-text endpoint; when empty it is derived from KB_AI_URL.
# With provider=openai you can leave it empty — dictation then goes to the same
# service (/audio/transcriptions).
KB_AI_TRANSCRIBE_URL=
# provider=openai only: transcription model (default whisper-1; Groq uses
# whisper-large-v3). Can also be set in Administration.
KB_AI_TRANSCRIBE_MODEL=
# provider=openai only: how many AI operations one person may run per hour.
# With your own API key every call costs money, so there is a cap by default —
# without one a single account could burn your credit in a loop.
KB_AI_MAX_PER_HOUR=60
# Same, just for dictation (uploading and transcribing audio is pricier).
KB_AI_MAX_TRANSCRIBE_PER_HOUR=20

# Daily AI task summary (the "AI summary of the day" section on the Tasks page).
# Generated automatically in the morning at KB_SUMMARY_HOUR (in the TZ zone,
# default 6) for users with open work; the "Refresh" button regenerates it anytime.
KB_SUMMARY_HOUR=6
# Morning generation only for accounts that signed in within the last N days
# (default 14, 0 = everyone). Inactive users get theirs when they open the app.
KB_SUMMARY_ACTIVE_DAYS=14
# Optional dedicated model JUST for summaries (bypasses the general AI config
# above — a smaller/faster model is enough for short formatted text). Empty =
# KB_AI_* / the settings from Administration are used.
KB_SUMMARY_PROVIDER=
KB_SUMMARY_URL=
KB_SUMMARY_MODEL=
KB_SUMMARY_TOKEN=

# "Report a bug or idea" (under the person icon): where reports are sent.
# EMPTY = the feature does not exist here — the route returns 404 and the menu
# item is not shown, so this instance never sends anything out on its own.
# Set your own address to collect reports from your users; the reporter's
# address goes into Reply-To, so you can answer straight from your inbox.
# Requires working SMTP (Mail settings in the PocketBase admin UI).
KB_REPORT_TO=

# Instance registration key (optional): when set, EVERY registration requires it.
# Useful for publicly reachable instances so that not just anyone can create an
# account. Empty = registration without a key (the first account registered is
# always the administrator).
KB_SETUP_CODE=

# Sign in with Google (optional): create an OAuth client in the Google Cloud
# Console (APIs & Services -> Credentials -> OAuth client ID -> Web application)
# and set as the "Authorized redirect URI":  https://YOUR-DOMAIN/api/oauth2-redirect
# Then paste the Client ID and Client secret here. Empty = Google sign-in is off.
KB_GOOGLE_CLIENT_ID=
KB_GOOGLE_CLIENT_SECRET=

# Google Drive picker (optional, needs the OAuth client above): enable the
# "Google Picker API" in the same Google Cloud project and create an API key.
# Attachments picked from Drive are stored as LINKS - files never leave Drive.
KB_GOOGLE_PICKER_API_KEY=

# E-mail (invitations, password reset): SMTP is configured in the PocketBase
# admin UI (http://SERVER-IP:8090/_/ -> Settings -> Mail settings), not in this
# file. Without SMTP everything works except e-mail — an invitation shows a
# temporary password for you to hand over.

# Update check (self-hosting): the signed-in user's BROWSER asks the GitHub API
# whether a newer release exists and the About dialog offers a link to it. The
# instance itself sends nothing anywhere — there is no telemetry and we learn
# nothing about your installation. Set to 0 to turn the check off entirely.
KB_UPDATE_CHECK=1
# Where releases are read from. Empty = the official repository; set it only if
# you run your own fork and want your own release notes.
KB_UPDATE_REPO=
# Running a beta? Set this to 1 and the check will also offer pre-releases
# (v0.34-beta and the like). Default 0 = stable releases only.
KB_UPDATE_PRERELEASE=0

# Deadline notices: hour of the morning digest (0–23, local TZ), default 7.
KB_DEADLINE_HOUR=7

# Notifications — budgets and batching. The defaults are sane; change them only
# if notices are too noisy, or if an automation of yours legitimately generates
# more than the cap and you are losing notices.
# Hour of the daily e-mail digest (0–23, local TZ), default 8.
KB_NOTIFY_DIGEST_HOUR=8
# Maximum in-app notices per recipient per day, default 50. Above the cap the
# individual rows are replaced by ONE growing summary ("+N more"), nothing is
# lost. There is no "unlimited" value - 0 means every notice is collapsed into
# that summary right away.
KB_NOTIFY_DAILY_CAP=50
# Maximum notification e-mails per recipient per day, default 10. Above the cap
# e-mails are DROPPED (the in-app notice still appears). 0 = send none at all.
KB_NOTIFY_EMAIL_DAILY_CAP=10
# Notices for the same recipient arriving within this many minutes are merged
# into a single message, default 10.
KB_NOTIFY_COALESCE_MIN=10

# Create the sample map ("Welcome to killBottleneck") for every new user?
# 0 = new accounts start empty. Default 1.
KB_UVODNI_MAPA=1

# Automations on goals (AI agent / cron) — YOU ONLY NEED THIS IF YOU USE THEM.
# The public address of this instance: killBottleneck sends it to the agent as
# callback_url, where it should report back when it finishes. Any address the
# agent can reach will do — on a self-host, a LAN address is fine
# (http://192.168.1.10:8090). When unset, the "Application URL" from the
# PocketBase admin UI is used, which after installation is http://localhost:8090
# — so an agent running on another machine would call itself. The AI agent
# registry in the app shows the currently effective address and warns about
# localhost.
KB_PUBLIC_URL=

# How many minutes an automation may run before the watchdog marks it failed
# (default 90).
KB_AGENT_TIMEOUT_MIN=90

# Allow the agent webhook to target PRIVATE networks too (10.x, 192.168.x,
# localhost). This is DISABLED by default — otherwise the server could be used
# to scan your internal network. Enable (=1) when n8n runs on the same LAN as
# killBottleneck.
KB_ALLOW_PRIVATE_WEBHOOKS=

# HOSTED instance (runs at a provider alongside other customers on one machine).
# Enabled (=1) means the instance administrator may not point the AI service into
# a private network — otherwise they could probe neighbouring containers and the
# provider's metadata service through "test connection". On your own server LEAVE
# THIS EMPTY: a local Ollama on 172.17.0.1 or on the LAN is the normal and correct
# setup there.
KB_HOSTED=

# Goal attachments: how many MB uploaded files may take up ACROSS THE WHOLE INSTANCE.
#   empty  = no limit (the default for self-hosting, it's your disk)
#   number = cap in MB (e.g. 5000 = 5 GB)
#   0      = uploading DISABLED, attachments are added as links only
# A link takes no space, the file stays with you and everyone works on the current
# version.
KB_FILES_MB=

# Notifications are now driven by per-user preferences and e-mail is off by
# default. If e-mails WERE already reaching you and you want to keep them after
# the upgrade, set this to 1 — then "e-mail on until the user turns it off" applies.
KB_NOTIFY_EMAIL_DEFAULT=
